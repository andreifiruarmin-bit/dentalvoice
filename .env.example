# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EMAIL_USER: The email address used to send confirmations (e.g., your Gmail).
EMAIL_USER="your-email@gmail.com"

# EMAIL_PASS: The app password for the email account.
EMAIL_PASS="your-app-password"

# EMAIL_HOST: The SMTP host for the email account.
EMAIL_HOST="smtp.gmail.com"

# EMAIL_PORT: The SMTP port for the email account.
EMAIL_PORT="465"

# FRONTEND_URL: The URL of the frontend application.
FRONTEND_URL="https://dentalvoice.ro"

# GOOGLE_SERVICE_ACCOUNT: The JSON string of your Google Service Account credentials.
GOOGLE_SERVICE_ACCOUNT='{"type": "service_account", ...}'

# Individual Google Service Account keys (alternative to GOOGLE_SERVICE_ACCOUNT)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
