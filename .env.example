# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar API a fost eliminat în v3.0
# Calendarul este acum intern (Supabase)
# CLINIC_TOTAL_DR_COUNT si DOCTOR_* raman pentru configurarea doctorilor

# Dynamic doctors: set count and parallel DOCTOR_*_{n} names, schedules
CLINIC_TOTAL_DR_COUNT=3
# CALENDAR_ID_DR* nu mai sunt necesare (eliminate in v3.0)

DOCTOR_NAME_DR1=Dr. Ionescu
DOCTOR_NAME_DR2=Dr. Andreescu
DOCTOR_NAME_DR3=Dr. Simonescu

DOCTOR_WORKING_DAYS_DR1=1,2,3,4,5
DOCTOR_WORKING_DAYS_DR2=1,3,5
DOCTOR_WORKING_DAYS_DR3=2,4

DOCTOR_START_HOUR_DR1=09:00
DOCTOR_END_HOUR_DR1=17:00
DOCTOR_START_HOUR_DR2=10:00
DOCTOR_END_HOUR_DR2=18:00
DOCTOR_START_HOUR_DR3=09:00
DOCTOR_END_HOUR_DR3=15:00

# Email Configuration (SMTP)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Clinic Configuration
# Clinic identifier for this deployment (multi-tenant: unique per clinic)
CLINIC_ID=beautiful-smile-demo
CLINIC_NAME=Beautiful Smile
CLINIC_ADDRESS=Strada Clinicilor nr. 24, București
CLINIC_PHONE=0700 000 000
CLINIC_MAPS_LINK=https://goo.gl/maps/example
CLINIC_WAZE_LINK=https://waze.com/ul/example

# Scheduling
SLOT_INTERVAL_MIN=60
DEFAULT_SERVICE_DURATION=30
MAX_ACTIVE_BOOKINGS=2
CLINIC_START_HOUR=09:00
CLINIC_END_HOUR=18:00
MIN_LEAD_TIME_HOURS=2
CLINIC_TIMEZONE=Europe/Bucharest

# Cache & Performance
DOCTOR_CACHE_TTL_MS=60000

# Slot Availability
SLOT_BUFFER_TODAY_MINUTES=30
NEXT_WORKING_DAYS_COUNT=5
MAX_DAY_SEARCH=60

# OTP Verification
OTP_EXPIRY_MINUTES=10
OTP_CODE_LENGTH=4

# Reminder System
REMINDER_END_BUFFER_MINUTES=30
CRON_WINDOW_MINUTES=60

# Security
ADMIN_API_KEY=dv-secret-key-2026
PENDING_STALE_MINUTES=5

# Cron (Vercel scheduled job auth)
CRON_SECRET=
TEST_PHONE=0700000000   # bookings limit bypassed for this number (testing only)

# WhatsApp session behavior
WA_SESSION_TIMEOUT_MIN=30

# Frontend (optional build-time overrides)
VITE_CLINIC_PHONE=
VITE_CLINIC_ADDRESS=

# Integrations
WHATSAPP_NUMBER=40700000000
WHATSAPP_GREETING_TEXT=Buna! Vreau o programare prin DentalVoice.
FACEBOOK_PAGE_ID=
FRONTEND_URL=http://localhost:3000

# Facebook Messenger Bot
FACEBOOK_PAGE_ACCESS_TOKEN=     # Page Access Token from Meta Developer Console
FACEBOOK_VERIFY_TOKEN=dentalvoice-fb-verify-2026  # Webhook verify token (can be any string)
MESSENGER_ID=                   # Page-scoped Messenger ID (optional)
